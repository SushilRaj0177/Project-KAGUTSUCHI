# Set by Vercel automatically once you add the Postgres storage
# integration (Storage tab -> Connect Store -> Postgres). For local dev,
# copy this file to .env.local and fill in a real connection string.
DATABASE_URL=

# Shared secret checked on POST /api/runs. Generate any random string and
# set the SAME value here and wherever integration/publish_result.py runs
# (as DASHBOARD_API_KEY).
INGEST_API_KEY=

# Public base URL of the always-on FastAPI backend (server/main.py) that
# powers the repo-scan homepage — e.g. your Cloudflare Tunnel URL
# (https://xxxxx.trycloudflare.com) or a real host once deployed. Exposed
# to the browser (NEXT_PUBLIC_*) since the scan form calls it directly.
NEXT_PUBLIC_KAGUTSUCHI_API_URL=
