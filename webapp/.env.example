# Base URL of the wsqfai FastAPI backend (wsqfai/server/main.py) that
# /analyze calls. Defaults to http://localhost:8000 if unset - see
# webapp/app/lib/api.ts. Set this to the backend's real deployed URL in
# production (Vercel project settings -> Environment Variables).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
