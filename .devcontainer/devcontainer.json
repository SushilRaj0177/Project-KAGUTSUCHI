{
  "name": "kagutsuchi-backend",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "KAGUTSUCHI API",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "pip install -r server/requirements.txt -r requirements.txt -r verification/requirements.txt",
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}"
  }
}
