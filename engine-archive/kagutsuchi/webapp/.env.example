# Set by Vercel automatically once you add the Postgres storage
# integration (Storage tab -> Connect Store -> Postgres). For local dev,
# copy this file to .env.local and fill in a real connection string.
DATABASE_URL=

# Shared secret checked on POST /api/runs. Generate any random string and
# set the SAME value here and wherever integration/publish_result.py runs
# (as DASHBOARD_API_KEY).
INGEST_API_KEY=

# Base URL of the FastAPI backend (server/main.py) -- e.g. a GitHub
# Codespaces forwarded-port URL or a real host once deployed. Server-only
# (NOT NEXT_PUBLIC_*): the browser calls our own /api/backend/* routes,
# which proxy to this URL server-side. This avoids a direct browser->
# backend fetch, which fails against Codespaces' port-forwarding proxy
# (it blocks third-party-origin CORS preflight requests regardless of
# what CORS headers the backend itself sends).
KAGUTSUCHI_API_URL=

# GitHub OAuth sign-in (lib/auth.ts) -- replaces having to paste a
# personal access token to open a PR (see components/FindingCard.tsx).
# Create at https://github.com/settings/applications/new with an
# Authorization callback URL of <your-site-url>/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random secret Auth.js uses to sign/encrypt session JWTs. Generate one
# with `openssl rand -base64 32`. Required in production.
AUTH_SECRET=
